# Copy to .env and fill in. Never commit .env.

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Speech-to-speech model that plays the patient.
REALTIME_MODEL=gpt-realtime-2.1

# Transcribes the practice's side of the call (their agent's speech).
TRANSCRIBE_MODEL=whisper-1

# Reads transcripts and drafts candidate bugs. Any chat model you have access to;
# a stronger reasoning model finds better issues.
ANALYSIS_MODEL=gpt-4o

# When to decide the other party has stopped talking. The most consequential
# setting here — see vad_config() in bridge.py.
#   server_vad   = fixed silence timer, lowest latency (default)
#   semantic_vad = model judges whether they're done. Handles trailing off better.
VAD_TYPE=server_vad

# server_vad only. Below ~800ms you start replying to half-finished sentences.
VAD_SILENCE_MS=900

# semantic_vad only: low | medium | high. Higher = quicker to take the turn.
VAD_EAGERNESS=medium

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The ONE number you bought and will use for every test call. Submit this exact
# number, in E.164, on the assessment form.
TWILIO_FROM_NUMBER=+15551234567

# ---------- Bridge ----------
# Public URL Twilio dials into, from `ngrok http 8080`. Take the https:// URL
# ngrok prints and swap the scheme for wss://
PUBLIC_WSS_URL=wss://your-subdomain.ngrok.app
PORT=8080
